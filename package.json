{
  "name": "srk-case-manager",
  "version": "5.4.1",
  "description": "SRK Case Manager Desktop Application",
  "author": "SRK",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "cap:sync": "cap sync",
    "cap:android": "cap open android",
    "test": "node --import tsx --test googleOAuthLoopback.test.cjs src/services/googleOAuthPkce.test.ts src/services/googleOAuthTokenClient.test.ts src/services/googleOAuthSession.test.ts src/services/syncJournal.test.ts src/services/companyChangeTracker.test.ts src/services/googleDriveSyncTransport.test.ts src/services/googleDriveSyncInbox.test.ts src/services/applySyncChanges.test.ts src/services/applyStagedInboxChanges.test.ts src/services/googleDriveSyncCoordinator.test.ts"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "@aparajita/capacitor-secure-storage": "^7.1.6",
    "@srk/capacitor-google-drive-auth": "file:./capacitor-google-drive-auth"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^4.17.21",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "in.srk.casemanage",
    "productName": "SRK Case Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "googleOAuthLoopback.cjs",
      "package.json"
    ],
    "extraMetadata": {
      "main": "main.cjs"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
